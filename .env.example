# Firebase Client Configuration (Overrides for Vercel, Netlify, or Custom Firebase Deployment)
# Note: In standard Firebase projects, leave VITE_FIREBASE_FIRESTORE_DATABASE_ID empty or set to (default).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# WhatsApp Business Cloud API Configuration (Optional)
# Meta for Developers (https://developers.facebook.com/) -> WhatsApp -> API Setup
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Optional Gemini API Key
GEMINI_API_KEY=

# Optional App Public URL
APP_URL=

